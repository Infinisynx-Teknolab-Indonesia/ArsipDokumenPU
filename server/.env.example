# Salin file ini menjadi .env lalu sesuaikan.

# Koneksi MySQL untuk aplikasi. Database & user ini DIBUAT OTOMATIS saat server start
# kalau belum ada (memakai MYSQL_ADMIN_URL di bawah) — tidak perlu setup_mysql.sql lagi.
DATABASE_URL=mysql+pymysql://arsip:arsip_pu_2026@localhost:3306/arsip_pu?charset=utf8mb4

# Akun admin MySQL yang dipakai SEKALI untuk membuat database + user di atas.
# XAMPP/Laragon bawaan: root tanpa password. Kalau root Anda pakai password: mysql+pymysql://root:PASSWORD@localhost:3306
MYSQL_ADMIN_URL=mysql+pymysql://root:@localhost:3306

# 1 = isi otomatis 9 proyek, 2 akun staf (budi/budi12345, sari/sari12345) dan 50 dokumen contoh
#     (tahun 2000-2026, sebagian saling berhubungan) saat database masih kosong. 0 = tidak.
SEED_DEMO=1

# Ganti dengan teks acak panjang (min. 32 karakter). Jangan dibagikan.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang-sekali-1234567890
JWT_HOURS=12

# Folder penyimpanan file dokumen di server
STORAGE_DIR=./storage

# Nama instansi yang tampil di aplikasi
AGENCY_NAME=Dinas Pekerjaan Umum dan Penataan Ruang

# Akun admin pertama (dibuat otomatis kalau tabel users masih kosong).
# WAJIB ganti password setelah login pertama.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=Admin@12345
FIRST_ADMIN_NAME=Admin Arsip

# Batas ukuran upload per file (MB)
MAX_UPLOAD_MB=100

# Alamat & port server (python run.py)
HOST=0.0.0.0
PORT=8000
